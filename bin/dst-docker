#!/bin/sh
set -eu
task_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$task_root"
command -v docker >/dev/null 2>&1 || { echo 'Docker is required. Run this inside Linux or your WSL distribution.' >&2; exit 1; }
docker compose version >/dev/null
case "${1:-up}" in
  up)
    docker compose -f packaging/docker/compose.assets.yaml build
    if ! docker compose -f packaging/docker/compose.assets.yaml run --rm --entrypoint python3 assets -c 'import json; from pathlib import Path; state=json.loads(Path("/srv/dst/install-state.json").read_text()); raise SystemExit(0 if state.get("state")=="downloaded" else 1)' >/dev/null 2>&1; then
      docker compose -f packaging/docker/compose.assets.yaml run --rm assets
    fi
    docker compose build map-observer-image scaler-image
    docker compose pull file-browser-image
    docker compose up --build -d
    task_attempt=0
    while [ "$task_attempt" -lt 30 ]; do
      if docker compose exec -T dst pwsh -NoLogo -NoProfile -File /opt/dst/healthcheck.ps1 >/dev/null 2>&1; then
        printf '\nOpen DST in your browser:\n'
        docker compose exec -T dst cat /data/state/DuneServer/last-url.txt
        exit 0
      fi
      task_attempt=$((task_attempt + 1))
      sleep 1
    done
    echo 'DST has not become ready. Inspect: sh bin/dst-docker logs' >&2
    exit 1
    ;;
  url) docker compose exec -T dst cat /data/state/DuneServer/last-url.txt ;;
  status) docker compose ps ;;
  logs) docker compose logs --tail=80 ;;
  down) docker compose down ;;
  *) echo 'Usage: sh bin/dst-docker [up|url|status|logs|down]' >&2; exit 1 ;;
esac
